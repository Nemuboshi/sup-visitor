{
  "name": "supview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run --exclude tests/e2e/**",
    "test:watch": "vitest --exclude tests/e2e/**",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "lean:sync": "leanfran sync --package .",
    "lean:check": "leanfran check --package . --require proved",
    "lean:status": "leanfran status --package ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "bits-ui": "^2.21.0",
    "leanfran": "^0.6.0"
  }
}
